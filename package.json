{
  "name": "depflow",
  "description": "is a simple dependency manager based on github repositories",
  "version": "3.0.0-dev.10",
  "main": "dist/cli/bin.js",
  "type": "module",
  "bin": {
    "dep": "dist/cli/bin.js"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "dev": "npx tsc --watch -p tsconfig.depflow.json",
    "build": "npm run clean && npx tsc -p tsconfig.depflow.json",
    "test": "npx tsc -p tsconfig.test.json && node --import ./tests/_register.mjs dist-test/tests/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "license": "Apache-2.0",
  "repository": {
    "url": "git+https://github.com/NetFeez/depflow.git"
  },
  "author": {
    "name": "NetFeez",
    "email": "netfeez.dev@gmail.com",
    "url": "https://NetFeez.github.io"
  },
  "keywords": [
    "dependency",
    "manager"
  ],
  "files": [
    "dist",
    "LICENCE",
    "README.md"
  ],
  "dependencies": {
    "@netfeez/common": "^4.2.0",
    "@netfeez/common-node": "^3.4.0",
    "@netfeez/schema": "^0.1.0",
    "@netfeez/vterm": "^1.1.0",
    "@netfeez/yaml": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2"
  }
}
