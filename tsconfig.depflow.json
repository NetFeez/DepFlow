{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "forceConsistentCasingInFileNames": true,
        "lib": [ "ESNext" ],
        "types": [ "node" ],
        "strict": true,
        "declaration": true,
        "composite": true,
        "sourceMap": true,
        "outDir": "dist",
        "rootDir": "src"
    },
    "include": [ "./src/**/*.ts" ]
}