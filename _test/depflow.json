{
  "outDir": ".",
  "tsconfig": "tsconfig.json",
  "importmap": "assets/importmap.json",
  "dependencies": [
    {
      "name": "NetFeez.vizui",
      "repo": "git@github.com:NetFeez/vizui.git",
      "builder": [
        {
          "run": [
            "npm install",
            "npm run compile"
          ],
          "move": {
            "build": "web/.lib/vizui"
          }
        }
      ],
      "resolver": [
        {
          "alias": "vizui",
          "target": {
            "local": "web/.lib/vizui/vizui.js",
            "cdn": "https://netfeez.github.io/vizui/v1.0.0/vizui.js"
          }
        },
        {
          "alias": "vizui/",
          "target": {
            "local": "web/.lib/vizui/",
            "cdn": "https://netfeez.github.io/vizui/v1.0.0/"
          }
        }
      ]
    }
  ],
  "npmDependencies": [
    {
      "name": "vortez",
      "resolver": [
        {
          "alias": "vortez",
          "target": {
            "local": "node_modules/vortez/build/vortez.js",
            "cdn": "https://vortez.netfeez.dev/cdn/v1.0.0/vortez.js"
          }
        },
        {
          "alias": "vortez/",
          "target": {
            "local": "node_modules/vortez/build/",
            "cdn": "https://vortez.netfeez.dev/cdn/v1.0.0/"
          }
        }
      ]
    }
  ]
}